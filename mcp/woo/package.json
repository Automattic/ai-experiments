{
  "name": "woocommerce-mcp-server",
  "version": "0.0.1",
  "description": "A Model Context Protocol server for interacting with WooCommerce.",
  "type": "module",
  "main": "./build/server.js",
  "exports": "./build/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node ./build/server.js",
    "dev": "tsx watch src/server.ts",
    "clean": "rimraf build"
  },
  "keywords": [
    "woocommerce",
    "mcp",
    "server",
    "claude",
    "ai"
  ],
  "author": "James LePage",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.4.1",
    "axios": "^1.6.7",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}